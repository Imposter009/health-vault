# =============================================================
# Health Vault — environment variables reference
# Copy this file to .env, fill in real values, then source it
# (or configure your IDE run-config to load .env).
# .env is .gitignored — never commit real credentials.
# =============================================================

# ---- Active Spring profile ----
# Options: local | docker | prod
SPRING_PROFILES_ACTIVE=local

# ---- PostgreSQL (used by Docker Compose + Spring Boot) ----
POSTGRES_DB=healthvault
POSTGRES_USER=healthvault
POSTGRES_PASSWORD=changeme_local_dev

# Spring datasource — used by backend directly
DB_URL=jdbc:postgresql://localhost:5432/healthvault
DB_USERNAME=healthvault
DB_PASSWORD=changeme_local_dev

# ---- Redis ----
# Required for JWT blacklist (logout) and rate limiting.
# Locally: start Redis via Docker Compose or native install (localhost:6379).
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=   # leave blank for local dev; set in prod

# ---- MinIO object storage (Phase 3) ----
# MinIO console available at http://localhost:9001 (credentials below)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=health-vault-documents
MINIO_PRESIGNED_URL_EXPIRY_MINUTES=5

# ---- Document upload (Phase 3) ----
# Max upload size in bytes (default: 25 MB = 26214400)
DOCUMENT_MAX_SIZE_BYTES=26214400

# ---- Document field-level encryption (Phase 3) ----
# AES-256-GCM key: must be base64-encoded 32 bytes (256 bits).
# Generate a real key: openssl rand -base64 32
# NEVER use the local-dev default below in any real environment.
# FUTURE IMPROVEMENT: key management and rotation via AWS KMS or HashiCorp Vault.
DOCUMENT_ENCRYPTION_KEY=bG9jYWwtZGV2LWtleS0zMmJ5dGVzLW5vdC1zZWN1cmU=

# ---- Kafka (Phase 4) ----
# Apache Kafka bootstrap server address. Kafka runs in Docker on port 9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- JWT (Phase 1) ----
# JWT_SECRET: raw string used as HMAC-SHA256 signing key.
# MUST be at least 32 characters (256 bits). Use a cryptographically-random
# value in any real environment — e.g. `openssl rand -base64 48 | tr -d '='`
# The placeholder below is ONLY safe for local dev.
JWT_SECRET=changeme-replace-with-32char-min-random-secret-key!
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# ---- Rate limiting (Phase 1) ----
# Applied to /api/auth/login and /api/auth/register, keyed by client IP.
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
