# =============================================================
# Health Vault — environment variables reference
# Copy this file to .env, fill in real values, then source it
# (or configure your IDE run-config to load .env).
# .env is .gitignored — never commit real credentials.
# =============================================================

# ---- Active Spring profile ----
# Options: local | docker | prod
SPRING_PROFILES_ACTIVE=local

# ---- PostgreSQL (used by Docker Compose + Spring Boot) ----
POSTGRES_DB=healthvault
POSTGRES_USER=healthvault
POSTGRES_PASSWORD=changeme_local_dev

# Spring datasource — used by backend directly
DB_URL=jdbc:postgresql://localhost:5432/healthvault
DB_USERNAME=healthvault
DB_PASSWORD=changeme_local_dev

# ---- Redis ----
# Required for JWT blacklist (logout) and rate limiting.
# Locally: start Redis via Docker Compose or native install (localhost:6379).
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=   # leave blank for local dev; set in prod

# ---- MinIO object storage (Phase 3) ----
# MinIO console available at http://localhost:9001 (credentials below)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=health-vault-documents
MINIO_PRESIGNED_URL_EXPIRY_MINUTES=5

# ---- Document upload (Phase 3) ----
# Max upload size in bytes (default: 25 MB = 26214400)
DOCUMENT_MAX_SIZE_BYTES=26214400

# ---- Document field-level encryption (Phase 3) ----
# AES-256-GCM key: must be base64-encoded 32 bytes (256 bits).
# Generate a real key: openssl rand -base64 32
# NEVER use the local-dev default below in any real environment.
# FUTURE IMPROVEMENT: key management and rotation via AWS KMS or HashiCorp Vault.
DOCUMENT_ENCRYPTION_KEY=bG9jYWwtZGV2LWtleS0zMmJ5dGVzLW5vdC1zZWN1cmU=

# ---- Kafka (Phase 4) ----
# Apache Kafka bootstrap server address. Kafka runs in Docker on port 9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- JWT (Phase 1) ----
# JWT_SECRET: raw string used as HMAC-SHA256 signing key.
# MUST be at least 32 characters (256 bits). Use a cryptographically-random
# value in any real environment — e.g. `openssl rand -base64 48 | tr -d '='`
# The placeholder below is ONLY safe for local dev.
JWT_SECRET=changeme-replace-with-32char-min-random-secret-key!
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# ---- Rate limiting (Phase 1) ----
# Applied to /api/auth/login and /api/auth/register, keyed by client IP.
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# ---- Gateway (Phase 5) ----
# Port the Spring Cloud Gateway listens on. Frontend sends all API requests here.
GATEWAY_PORT=8081
# URL of the Core API (backend). Gateway forwards all /api/** requests here.
CORE_API_URL=http://localhost:8080

# Gateway rate-limit tuning — token bucket algorithm.
# replenishRate: tokens added per second (sustained throughput).
# burstCapacity: max tokens at any moment (burst allowance).
GATEWAY_RATE_LOGIN_REPLENISH=1
GATEWAY_RATE_LOGIN_BURST=5
GATEWAY_RATE_REGISTER_REPLENISH=2
GATEWAY_RATE_REGISTER_BURST=5
GATEWAY_RATE_UPLOAD_REPLENISH=5
GATEWAY_RATE_UPLOAD_BURST=10
GATEWAY_RATE_AI_CHAT_REPLENISH=2
GATEWAY_RATE_AI_CHAT_BURST=5
GATEWAY_RATE_AI_TREND_REPLENISH=5
GATEWAY_RATE_AI_TREND_BURST=10

# ---- Observability (Phase 7) ────────────────────────────────────────────────

# Grafana admin credentials.
# MUST be changed from the defaults before any internet-facing deployment.
# Generate a strong password: openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana

# Zipkin endpoint — both Java modules export OTel spans here.
# In docker profile this is overridden to http://zipkin:9411/api/v2/spans in
# application-docker.yml; set this variable only for local runs pointing at a
# remote Zipkin instance.
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# ---- AI features (Phase 10) ──────────────────────────────────────────────
# Set AI_FEATURES_ENABLED=true to activate Spring AI endpoints.
# All other AI_* variables are ignored when AI_FEATURES_ENABLED=false (default).
# The core app (Phases 0-9) works fully without any of these variables.
AI_FEATURES_ENABLED=false

# OpenAI API key — required when AI_FEATURES_ENABLED=true.
# Generate at: https://platform.openai.com/api-keys
# NEVER commit a real key. Use a secret manager in production.
OPENAI_API_KEY=sk-...your-key-here...

# Chat model to use for summarization, RAG Q&A, and trend narration.
# gpt-4o-mini is cost-efficient and sufficient for medical document tasks.
AI_CHAT_MODEL=gpt-4o-mini

# Embedding model — must produce 1536-dimensional vectors.
# text-embedding-3-small matches the VECTOR(1536) column in V8 migration.
# Changing this requires dropping and re-creating all rows in document_embeddings.
AI_EMBEDDING_MODEL=text-embedding-3-small

# Optional tuning (defaults are suitable for most deployments)
# AI_SUMMARIZATION_MAX_INPUT_CHARS=12000
# AI_MAX_RESPONSE_TOKENS=512
# AI_RAG_TOP_K=5
# AI_CHAT_HISTORY_MAX_MESSAGES=10
# AI_TREND_SLOPE_THRESHOLD=0.05
# AI_CHUNK_SIZE_CHARS=1000
# AI_CHUNK_OVERLAP_CHARS=200
