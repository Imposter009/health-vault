# =============================================================
# Health Vault — environment variables reference
# Copy this file to .env, fill in real values, then source it
# (or configure your IDE run-config to load .env).
# .env is .gitignored — never commit real credentials.
# =============================================================

# ---- Active Spring profile ----
# Options: local | docker | prod
SPRING_PROFILES_ACTIVE=local

# ---- PostgreSQL (used by Docker Compose + Spring Boot) ----
POSTGRES_DB=healthvault
POSTGRES_USER=healthvault
POSTGRES_PASSWORD=changeme_local_dev

# Spring datasource — used by backend directly
DB_URL=jdbc:postgresql://localhost:5432/healthvault
DB_USERNAME=healthvault
DB_PASSWORD=changeme_local_dev

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MinIO object storage ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=changeme_minio_access
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET_NAME=health-vault

# ---- JWT (placeholder — set real value via secret manager in prod) ----
# Minimum 32 characters for HS256
JWT_SECRET=changeme_jwt_secret_placeholder_minimum_32_chars
JWT_EXPIRY_MS=86400000
