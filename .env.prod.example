# =============================================================
# Health Vault — PRODUCTION environment variables
# Copy to .env.prod, fill in real generated values, keep it OFF the server's
# git working tree (or make sure .env.prod stays gitignored — it already is).
#
# See DEPLOYMENT.md for exactly how to generate each secret below.
# =============================================================

# ---- Your domain (DNS A/AAAA record must already point at this server) ----
DOMAIN=example.com

# ---- PostgreSQL ----
POSTGRES_DB=healthvault
POSTGRES_USER=healthvault
POSTGRES_PASSWORD=REPLACE_ME

# ---- Redis ----
# Leave blank to run Redis without a password (fine — it's bound to 127.0.0.1
# only and never leaves the docker network). Set one if you want defense in depth.
REDIS_PASSWORD=

# ---- MinIO object storage ----
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME
MINIO_BUCKET_NAME=health-vault-documents

# ---- JWT signing key ----
# Generate: openssl rand -base64 48 | tr -d '='
JWT_SECRET=REPLACE_ME
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# ---- Document field-level encryption (AES-256-GCM) ----
# Generate: openssl rand -base64 32
# CRITICAL: back this up somewhere safe (password manager / secret vault).
# If you lose it, every stored document becomes permanently unreadable.
DOCUMENT_ENCRYPTION_KEY=REPLACE_ME

# ---- Gateway rate limiting (defaults are sane — only change if you know why) ----
GATEWAY_RATE_LOGIN_REPLENISH=1
GATEWAY_RATE_LOGIN_BURST=5
GATEWAY_RATE_REGISTER_REPLENISH=2
GATEWAY_RATE_REGISTER_BURST=5
GATEWAY_RATE_UPLOAD_REPLENISH=5
GATEWAY_RATE_UPLOAD_BURST=10
GATEWAY_RATE_AI_CHAT_REPLENISH=2
GATEWAY_RATE_AI_CHAT_BURST=5
GATEWAY_RATE_AI_TREND_REPLENISH=5
GATEWAY_RATE_AI_TREND_BURST=10

# ---- AI features (optional) ----
AI_FEATURES_ENABLED=false
# OPENAI_API_KEY=sk-...

# ---- Image tag (leave as "latest" unless you're doing tagged releases) ----
IMAGE_TAG=latest
